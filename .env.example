# Copy this file to .env and fill in your own values before running/deploying.

# Password the organizer uses to log into /admin.html to view the fines log.
ADMIN_PASSWORD=changeme123

# Random long string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Port the server listens on (most hosts inject this automatically).
PORT=3000
